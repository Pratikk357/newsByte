# Copy this file to .env (next to docker-compose.yml) and fill in the values.
# Used only by the root docker-compose.yml.

# Long random string used to sign login tokens (required)
JWT_SECRET=change_me_to_a_long_random_string

# Shared secret between the scraper and the backend consumer (required)
MQ_SECRET_KEY=change_me_to_a_long_random_string

# Optional
POSTGRES_PASSWORD=newspassword
# Seconds between scraper runs (default 6 hours)
SCRAPE_INTERVAL=21600
