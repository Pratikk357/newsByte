PORT=3000
# Long random string used to sign login tokens (required)
JWT_SECRET=change_me_to_a_long_random_string

# Matches the postgres service in docker-compose.yaml
DATABASE_URL=postgresql://newsuser:newspassword@localhost:5432/news_db

RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Shared secret the scraper sends with every message.
# Must be exactly the same as MQ_SECRET_KEY in scrapper/news_scrapper/.env
MQ_SECRET_KEY=change_me_to_a_long_random_string
