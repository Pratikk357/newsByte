  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:consumer": "nest start --entryFile rabbit-mq",
    "start:consumer:dev": "nest start --watch --entryFile rabbit-mq",
    "start:consumer:prod": "node dist/rabbit-mq",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "migrate:make": "prisma migrate dev",
    "migrate:generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:push": "prisma db push",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
